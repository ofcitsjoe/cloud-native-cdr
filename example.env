# SENTINEL-X server configuration
# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:sentinel@localhost:5432/sentinelx

# Signing secret for JWT session tokens — use a long random string in production
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# API port
PORT=8080

# Allowed frontend origin for CORS (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173

# Global rate limiting
RATE_WINDOW_MS=60000
RATE_MAX=120

# Seeder demo analyst password (bcrypt-hashed on insert)
SEED_ANALYST_PASSWORD=sentinel-demo
