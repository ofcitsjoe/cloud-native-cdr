# =========================
# Infrastructure (Terraform)
# =========================
# Local .terraform directories
**/.terraform/*
# .tfstate files contain sensitive AWS architecture data and secrets!
*.tfstate
*.tfstate.*
# Crash log files
crash.log
crash.*.log
# Variables files (often contain AWS keys or account IDs)
*.tfvars
*.tfvars.json

# =========================
# Backend (Python/FastAPI)
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# Virtual Environments
venv/
env/
.venv/
# Environment variables (Never commit your AWS access keys)
.env
.env.*
*.log

# =========================
# Frontend (React/Vite)
# =========================
# Node dependencies (massive file size)
node_modules/
dashboard/node_modules/
# Production build outputs
dist/
dashboard/dist/
build/
# Vite caching
.vite/
# NPM/Yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# =========================
# Editor & OS (VS Code / Linux / Windows)
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db